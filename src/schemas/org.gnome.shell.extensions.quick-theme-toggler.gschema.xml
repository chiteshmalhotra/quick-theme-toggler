<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema id="org.gnome.shell.extensions.quick-theme-toggler" path="/org/gnome/shell/extensions/quick-theme-toggler/">
		<!-- Appearance -->
		<key name="icon-display" type="b">
			<default>true</default>
		</key>
		<key name="light-icon" type="i">
			<default>0</default>
		</key>
		<key name="dark-icon" type="i">
			<default>1</default>
		</key>
		<key name="icon-box-enum" type="i">
			<default>2</default>
		</key>
		<key name="icon-offset" type="i">
			<default>1</default>
			<range min="0" max="16"/>
		</key>
		<key name="use-custom-accent" type="b">
            <default>false</default>
        </key>
        <key name="light-accent" type="i">
            <default>1</default>
        </key>
		<key name="dark-accent" type="i">
            <default>5</default>
        </key>
		<key name="smooth-transition" type="b">
            <default>true</default>
        </key>
		<!-- Behaviour -->
		<key name="theme-shortcut" type="as">
			<default>["&lt;Super&gt;&lt;Shift&gt;t"]</default>
		</key>
		<key name="left" type="i">
            <default>1</default>
        </key>
		<key name="right" type="i">
            <default>2</default>
        </key>
        <key name="force-light" type="b">
            <default>false</default>
        </key>
		<!-- Experiment -->
		<key name="enable-experiment" type="b">
            <default>false</default>
        </key>
		<key name="icon-rotate" type="i">
            <default>40</default>
			<range min="0" max="360" />
        </key>
		<key name="icon-dur" type="i">
			<default>300</default>
			<range min="0" max="1000" />
		</key>
	</schema>
</schemalist>