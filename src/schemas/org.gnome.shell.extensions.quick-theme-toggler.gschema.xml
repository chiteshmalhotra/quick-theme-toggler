<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema id="org.gnome.shell.extensions.quick-theme-toggler" path="/org/gnome/shell/extensions/quick-theme-toggler/">
		<!-- Appearance -->
		<key name="show-indicator" type="b">
			<default>true</default>
		</key>
		<key name="icon-set" type="i">
			<default>0</default>
		</key>
		<key name="icon-mov" type="b">
			<default>true</default>
		</key>
		<key name="icon-dur" type="i">
			<default>300</default>
			<range min="0" max="1000"/>
		</key>
		<key name="icon-box-enum" type="i">
			<default>2</default>
		</key>
		<key name="icon-offset" type="i">
			<default>1</default>
			<range min="0" max="16"/>
		</key>
		<!-- Behaviour -->
		<key name="shortcut" type="as">
			<default>['&lt;Super&gt;&lt;Shift&gt;t']</default>
		</key>
		<key name="left-click" type="i">
            <default>1</default>
        </key>
		<key name="right-click" type="i">
            <default>2</default>
        </key>
        <key name="force-light" type="b">
            <default>false</default>
        </key>
	</schema>
</schemalist>