<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
    <schema id="org.gnome.shell.extensions.quick-theme-toggler" path="/org/gnome/shell/extensions/quick-theme-toggler/">
        <!-- Appearance -->
        <key name="light-bg" type="s">
            <default>""</default>
        </key>
        <key name="dark-bg" type="s">
            <default>""</default>
        </key>
        <key name="light-accent" type="i">
            <default>0</default>
        </key>
        <key name="dark-accent" type="i">
            <default>8</default>
        </key>
        <key name="dynamic-icon-theme" type="b">
            <default>false</default>
        </key>
        <key name="light-icon-theme" type="i">
            <default>0</default>
        </key>
        <key name="dark-icon-theme" type="i">
            <default>0</default>
        </key>
        <key name="visible" type="b">
            <default>true</default>
        </key>
        <key name="icon" type="i">
            <default>0</default>
        </key>
        <key name="region" type="i">
            <default>2</default>
        </key>
        <key name="offset" type="i">
            <default>1</default>
            <range min="0" max="16"/>
        </key>
        <key name="transition" type="b">
            <default>true</default>
        </key>
        <key name="force-light" type="b">
            <default>false</default>
        </key>

        <!-- Behavior -->
        <key name="theme-shortcut" type="as">
            <default>["&lt;Super&gt;&lt;Shift&gt;t"]</default>
        </key>
        <key name="prefs-shortcut" type="as">
            <default>["&lt;Alt&gt;&lt;Shift&gt;t"]</default>
        </key>
        <key name="left" type="i">
            <default>1</default>
        </key>
        <key name="right" type="i">
            <default>2</default>
        </key>
    </schema>
</schemalist>